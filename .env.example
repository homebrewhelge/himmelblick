# HimmelBlick – Optionale Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an

# Backend
REDIS_URL=redis://cache:6379
CORS_ORIGINS=http://localhost
LOG_LEVEL=info

# Optionale API-Keys (aktuell alle genutzten APIs sind kostenlos/keylos)
# BRIGHTSKY_API_KEY=
# OPENWEATHER_API_KEY=

# DWD Radar (Standard-URL, normalerweise nicht ändern)
DWD_RADAR_BASE_URL=https://opendata.dwd.de/weather/radar/composit/rx
DWD_WARNINGS_URL=https://www.dwd.de/DWD/warnungen/warnapp/json/warnings.json
